function FL_Viewer()
    % --- CONFIGURACIÓN DE LA FIGURA ---
    fig = uifigure('Name', 'ETR11 Geometry Live - Points & Bars', 'Position', [100 100 1100 750], 'Color', [0.1 0.1 0.1]);
    ax = uiaxes(fig, 'Position', [250 50 800 650], 'BackgroundColor', [0 0 0], 'XColor', 'w', 'YColor', 'w', 'ZColor', 'w');
    hold(ax, 'on'); grid(ax, 'on'); axis(ax, 'equal'); view(ax, 3);
    ax.XLim = [-500 400]; ax.YLim = [-800 -100]; ax.ZLim = [-50 750];

    % --- PUNTOS FIJOS DEL CHASIS (Extraídos de tu función) ---
    MC.URW = [80, -225, 268]; MC.UFW = [-210, -225, 277];
    MC.LRW = [85, -225, 136]; MC.LFW = [-210, -225, 123];
    MC.DPR = [164, -112, 610]; MC.RKR_AX = [-26, -186.5, 587];

    % --- OBJETOS GRÁFICOS (BARRAS) ---
    % Blancos: Wishbones, Damper, Pushrod y Rocker
    h.UW = plot3(ax, 0,0,0, 'w', 'LineWidth', 2);
    h.LW = plot3(ax, 0,0,0, 'w', 'LineWidth', 2);
    h.PUSH = plot3(ax, 0,0,0, 'w', 'LineWidth', 2);
    h.DPR = plot3(ax, 0,0,0, 'w', 'LineWidth', 2);
    h.RKR = plot3(ax, 0,0,0, 'w', 'LineWidth', 1.5);
    
    % Amarillos: Tie Rod y Spindle
    h.TR = plot3(ax, 0,0,0, 'y', 'LineWidth', 2);
    h.Spindle = plot3(ax, 0,0,0, 'y', 'LineWidth', 3);
    h.Conn = plot3(ax, 0,0,0, 'y', 'LineWidth', 1.5);
    
    % --- OBJETOS GRÁFICOS (PUNTOS/NODOS) ---
    h.PtsW = plot3(ax, 0,0,0, 'wo', 'MarkerFaceColor', 'w', 'MarkerSize', 4); % Nodos blancos
    h.PtsY = plot3(ax, 0,0,0, 'yo', 'MarkerFaceColor', 'y', 'MarkerSize', 4); % Nodos amarillos

    % Neumático
    [xc, yc, zc] = cylinder((16*25.4)/2, 40); 
    zc = (zc - 0.5) * (7.5*25.4);
    h.Wheel = surface(ax, xc, yc, zc, 'FaceColor', [0.4 0.4 0.4], 'EdgeColor', 'none', 'FaceAlpha', 0.1);

    % --- SLIDERS CON ACTUALIZACIÓN CONTINUA ---
    uilabel(fig, 'Position', [50 550 150 20], 'Text', 'Ángulo Volante', 'FontWeight', 'bold', 'FontColor', 'w');
    s_steer = uislider(fig, 'Position', [50 530 150 3], 'Limits', [-90 90], 'Value', 0);
    
    uilabel(fig, 'Position', [50 450 150 20], 'Text', 'Compresión Damper', 'FontWeight', 'bold', 'FontColor', 'w');
    s_comp = uislider(fig, 'Position', [50 430 150 3], 'Limits', [0 50], 'Value', 0);

    s_steer.ValueChangingFcn = @(src, event) updatePlot(event.Value, s_comp.Value);
    s_comp.ValueChangingFcn = @(src, event) updatePlot(s_steer.Value, event.Value);

    function updatePlot(steer_val, comp_val)
        % 1. Llamada a tu función
        [uw_kn, lw_kn, tr_rack, tr_upr, dpr_rkr, push_uw, push_rkr, s_cnt, s_inn, cp, kp_gnd] = ...
            FL_SOLVER_ETR11_rodri(steer_val, comp_val);
        
        % 2. Sincronización del chasis con el z_offset dinámico
        z_off = 150.68 - tr_rack(3); 
        off = [0, 0, z_off];
        cURW = MC.URW-off; cUFW = MC.UFW-off; cLRW = MC.LRW-off; cLFW = MC.LFW-off; cDPR = MC.DPR-off; cRKR = MC.RKR_AX-off;

        % 3. Actualizar Barras Blancas
        set(h.UW, 'XData', [cUFW(1) uw_kn(1) cURW(1)], 'YData', [cUFW(2) uw_kn(2) cURW(2)], 'ZData', [cUFW(3) uw_kn(3) cURW(3)]);
        set(h.LW, 'XData', [cLFW(1) lw_kn(1) cLRW(1)], 'YData', [cLFW(2) lw_kn(2) cLRW(2)], 'ZData', [cLFW(3) lw_kn(3) cLRW(3)]);
        set(h.PUSH, 'XData', [push_uw(1) push_rkr(1)], 'YData', [push_uw(2) push_rkr(2)], 'ZData', [push_uw(3) push_rkr(3)]);
        set(h.DPR, 'XData', [dpr_rkr(1) cDPR(1)], 'YData', [dpr_rkr(2) cDPR(2)], 'ZData', [dpr_rkr(3) cDPR(3)]);
        set(h.RKR, 'XData', [cRKR(1) dpr_rkr(1) push_rkr(1) cRKR(1)], 'YData', [cRKR(2) dpr_rkr(2) push_rkr(2) cRKR(2)], 'ZData', [cRKR(3) dpr_rkr(3) push_rkr(3) cRKR(3)]);

        % 4. Actualizar Barras Amarillas
        set(h.TR, 'XData', [tr_rack(1) tr_upr(1)], 'YData', [tr_rack(2) tr_upr(2)], 'ZData', [tr_rack(3) tr_upr(3)]);
        set(h.Spindle, 'XData', [s_cnt(1) s_inn(1)], 'YData', [s_cnt(2) s_inn(2)], 'ZData', [s_cnt(3) s_inn(3)]);
        set(h.Conn, 'XData', [s_inn(1) tr_upr(1)], 'YData', [s_inn(2) tr_upr(2)], 'ZData', [s_inn(3) tr_upr(3)]);

        % 5. Actualizar Puntos (Nodos)
        % Nodos de componentes blancos
        all_pts_w = [cUFW; cURW; cLFW; cLRW; uw_kn; lw_kn; push_uw; push_rkr; dpr_rkr; cDPR; cRKR];
        set(h.PtsW, 'XData', all_pts_w(:,1), 'YData', all_pts_w(:,2), 'ZData', all_pts_w(:,3));
        
        % Nodos de componentes amarillos
        all_pts_y = [tr_rack; tr_upr; s_cnt; s_inn];
        set(h.PtsY, 'XData', all_pts_y(:,1), 'YData', all_pts_y(:,2), 'ZData', all_pts_y(:,3));

        % 6. Orientar Rueda
        s_vec = (s_inn - s_cnt);
        s_vec = s_vec / norm(s_vec);
        k = [0 0 1]; v = cross(k, s_vec); c = dot(k, s_vec);
        vx = [0 -v(3) v(2); v(3) 0 -v(1); -v(2) v(1) 0];
        Rmat = eye(3) + vx + vx^2 * (1/(1+c));
        pts = Rmat * [xc(:)'; yc(:)'; zc(:)'];
        set(h.Wheel, 'XData', reshape(pts(1,:), size(xc)) + s_cnt(1), ...
                     'YData', reshape(pts(2,:), size(xc)) + s_cnt(2), ...
                     'ZData', reshape(pts(3,:), size(xc)) + s_cnt(3));
    end
    
    updatePlot(0, 0);
end