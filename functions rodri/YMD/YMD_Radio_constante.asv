clear all
clc
close all

% añadir valores de control y estabilidad para ay máx, y filtras valores
% para control y estabilidad mínimos factibles.

car = struct(); % Definiciones del coche

g=9.81; %m/s^2

car.l=1.535; % Wheelbase [m]
car.a = 0.5*car.l;% Distancia CG a front axle [m]
car.b = car.l-car.a;% Distancia Cg a rear axle [m]
car.Tf = 1.25;% Trackwith front [m]
car.Tr = 1.25;% Trackwith rear [m]
car.m = 205+70; % Pes coche + piloto [kg]
car.Zrf=0.07; % Roll center height front [m]
car.Zrr=0.08; % Roll center height rear [m]
car.H=0.225; % distancia CG a roll axis [m]
car.Kf= 18370.86641; % roll stiffnes front [Nm/rad]
car.Kr= 18370.86641; % roll stiffnes rear [Nm/rad]
car.h= 0.26; 
car.copx=475/1600; % centre de pressions en x (porcentaje de wheelbase desde eje delantero)
car.copz = 0.595; % altura centro de presiones [m]

RL_camber_estatic = -2;
RR_camber_estatic = -2;
roll_to_camber = 0.63;
roll = 0;

% AERO
df_coeff = 4.18; % coeficiente downforce
dr_coeff = 1.3; % coeficiente drag
air_d = 1.225; % densidad del aire [kg/m^3]
area = 0.563; % área frontal del coche [m^2]

% Inputs
R = 10; % Radio de giro [m]

steer_int= -120:5:120; % Intervalo Steering wheel angle [rad]
yaw_slip_int = deg2rad(-15:1:15); % Intervalo Slip de CG en [rad]

Wf = g*car.m*car.b/(car.l); % peso sobre eje delantero [N]
Wr = g*car.m*car.a/(car.l); % peso sobre eje trasero [N]
idx_steer = 1;
idx_yawslip = 1;
yaw_moment_matrix = zeros(length(steer_int), length(yaw_slip_int));
ay_matrix = zeros(length(steer_int), length(yaw_slip_int));

v = 10; % v inicial
ay = sqrt(v*R)/g; % lat acc
yaw_vel = v/R;

FR_steer = 0;
FL_steer = 0;

ay_maximum=0;
yaw_moment_ay_max=0;
ay_minimum=0;
yaw_moment_ay_min=0;
slips_max_ay = zeros(1, 4);
loads_max_ay = zeros(1, 4);

for steer = steer_int

        for yaw_slip = yaw_slip_int

            for k = 1:10

                % ROLL
                roll = (car.h*car.m*ay*g)/(car.Kf + car.Kr); % roll [rads]

                % Camber gain trasero
                RL_camber = RL_camber_estatic - roll_to_camber * roll;
                RR_camber = RR_camber_estatic + roll_to_camber * roll;
                
                % LLAMADA FUNCIÓN GEOMETRÍA.
                [FL_steer, FR_steer, FL_camber, FR_camber] = ackermann_function_3D(steer, rad2deg(roll));
                
                Vx = cos(yaw_slip)*v; % Velocidad x
                Vy = sin(yaw_slip)*v; % Velocidad y
                yaw_vel = v/R;
    
                % DOWNFORCE Y DRAG SOBRE CADA EJE
                dForce = 0.5*air_d*area*df_coeff*v^2; % downforce total [N]
                dForce_front = dForce*(1-car.copx); % downforce eje delantero [N]
                dForce_rear = dForce*car.copx; % downforce eje trasero [N]
                drag = 0.5*air_d*area*dr_coeff*v^2; % cálculo drag [N]
                drag_front = - drag*car.copz/car.l; % carga que aporta el drag del eje delantero [N] (es negativa, por lo que realmente es carga que quita)
                drag_rear = - drag_front; % carga que aporta el drag sobre el eje trasero [N] (es positiva, por lo que aporta carga, exactamente la carga que se quita del eje delantero)
    
                % SLIPS NEUMÁTICO             
                FL_slip =  atand((Vy + yaw_vel*car.a)/(Vx + (yaw_vel*car.Tf/2))) - FL_steer; % front left slip angle [rad]
                FR_slip =  atand((Vy + yaw_vel*car.a)/(Vx - (yaw_vel*car.Tf/2))) - FR_steer; % front right slip angle [rad]
                RL_slip =  atand((Vy - yaw_vel*car.b)/(Vx + (yaw_vel*car.Tr/2))); % rear left slip angle [rad]
                RR_slip =  atand((Vy - yaw_vel*car.b)/(Vx - (yaw_vel*car.Tr/2))); % rear right slip angle [rad]
               
                %WEIGHT TRASNFER
                [FZ_FL, FZ_FR, FZ_RL, FZ_RR] = normal_load_per_tire_complete(car.m, ay, car.Tf, car.Tf, car.Zrf, car.Zrr, car.Kf, car.Kr, car.H, car.l, car.a); % llamada función laod transfer, devuelve carga sobre cada rueda, sin contar downforce
    
                % TOTAL LOAD
                FZ_FL = FZ_FL + (dForce_front + drag_front)/2; % total load on front left [N]
                FZ_FR = FZ_FR + (dForce_front + drag_front)/2;% total load on front right [N]
                FZ_RL = FZ_RL + (dForce_rear + drag_rear)/2; % total load on rear left [N]
                FZ_RR = FZ_RR + (dForce_rear + drag_rear)/2; % total load on rear right [N]

                % TIRE MODEL FORCES

                % 1. FRONT LEFT (Fl) - Camber NEGATIVO
                [Fx_FL, Fy_FL, Fz_out_FL, Mx_FL, My_FL, Mz_FL, kappa_FL, alpha_FL, gamma_FL, phit_FL, Vx_FL, P_FL, Re_FL, rho_FL, two_a_FL, t_FL, mux_FL, muy_FL, omega_FL, Rl_FL, two_b_FL, Mzr_FL, Cx_FL, Cy_FL, Cz_FL, Kya_FL, sigmax_FL, sigmay_FL, dFy_dSA_FL, Kxk_FL]... 
                = mfeval_function(FZ_FL, 0, FL_slip, -FL_camber, v);
            
                % 2. FRONT RIGHT (FR) - Camber Positivo
                [Fx_FR, Fy_FR, Fz_out_FR, Mx_FR, My_FR, Mz_FR, kappa_FR, alpha_FR, gamma_FR, phit_FR, Vx_FR, P_FR, Re_FR, rho_FR, two_a_FR, t_FR, mux_FR, muy_FR, omega_FR, Rl_FR, two_b_FR, Mzr_FR, Cx_FR, Cy_FR, Cz_FR, Kya_FR, sigmax_FR, sigmay_FR, dFy_dSA_FR, Kxk_FR] ...
                = mfeval_function(FZ_FR, 0, FR_slip, FR_camber, v);
            
                % 3. REAR LEFT (RL) - Camber Negativo
                [Fx_RL, Fy_RL, Fz_out_RL, Mx_RL, My_RL, Mz_RL, kappa_RL, alpha_RL, gamma_RL, phit_RL, Vx_RL, P_RL, Re_RL, rho_RL, two_a_RL, t_RL, mux_RL, muy_RL, omega_RL, Rl_RL, two_b_RL, Mzr_RL, Cx_RL, Cy_RL, Cz_RL, Kya_RL, sigmax_RL, sigmay_RL, dFy_dSA_RL, Kxk_RL] ...
                = mfeval_function(FZ_RL, 0, RL_slip, -RL_camber, v);
            
                % 4. REAR RIGHT (RR) - Camber Positivo
                [Fx_RR, Fy_RR, Fz_out_RR, Mx_RR, My_RR, Mz_RR, kappa_RR, alpha_RR, gamma_RR, phit_RR, Vx_RR, P_RR, Re_RR, rho_RR, two_a_RR, t_RR, mux_RR, muy_RR, omega_RR, Rl_RR, two_b_RR, Mzr_RR, Cx_RR, Cy_RR, Cz_RR, Kya_RR, sigmax_RR, sigmay_RR, dFy_dSA_RR, Kxk_RR] ...
                = mfeval_function(FZ_RR, 0, RR_slip, RR_camber, v);
                
                % EACH TIRE'S FY, FX AND MZ
                FX_FL = Fx_FL; FY_FL = -Fy_FL; MZ_FL = Mz_FL;
                FX_FR = Fx_FR; FY_FR = -Fy_FR; MZ_FR = Mz_FR;
                FX_RL = Fx_RL; FY_RL = -Fy_RL; MZ_RL = Mz_RL;
                FX_RR = Fx_RR; FY_RR = -Fy_RR; MZ_RR = Mz_RR;
    
                % YAW AND AY CALCULATIONS
                ay = (FY_RR + FY_RL + FY_FR*cos(FR_steer) + FY_FL*cos(FL_steer))/(car.m *g); % aceleración lateral resultante [g]
                yaw_moment = ((FY_FR*cos(FR_steer) + FY_FL*cos(FL_steer))*car.a - (FY_RR + FY_RL)*car.b - (MZ_RR + MZ_RL + MZ_FL + MZ_FR));
                v = sqrt(abs(ay*g*R));
            end
            if ay > ay_maximum
                    ay_maximum = ay; % Update maximum lateral acceleration
                    yaw_moment_ay_max = yaw_moment;
                    slips_max_ay = rad2deg([FL_slip, FR_slip, RR_slip, RL_slip]);
                    loads_max_ay = [FZ_FL, FZ_FR, FZ_RL, FZ_RR];
                    fys_max_ay = [FY_FL, FY_FR, FY_RL, FY_RR];
                    wheelsteers_max_ay = rad2deg([FL_steer, FR_steer, 0, 0]);
                    steer_max_ay = (steer);
                    yaw_slip_max_ay = rad2deg(yaw_slip);
                    v_max = v;
            end
            yaw_moment_matrix(idx_steer, idx_yawslip) = yaw_moment ;
            ay_matrix(idx_steer, idx_yawslip) = ay;
            idx_yawslip = idx_yawslip + 1;
          
        end
        idx_yawslip = 1;
        idx_steer = idx_steer + 1;
    
end

ay_maximum 
yaw_moment_ay_max
fys_max_ay;
steer_max_ay
yaw_slip_max_ay
v_max
data_ay_max = table(slips_max_ay', loads_max_ay', fys_max_ay', wheelsteers_max_ay',  'VariableNames', {'Slip angle [deg]', 'FZ [N]', 'FY [N]', 'Steer input [deg]'}, 'RowNames', {'Front Left', 'Front Right', 'Rear Left', 'Rear Right'})


figure(1)
plot(ay_matrix, yaw_moment_matrix, '.')
hold on
plot(ay_matrix', yaw_moment_matrix', '.')
grid on



% --- Configuración de la Figura ---
fig = figure('Color', [0.1 0.1 0.1], 'Position', [100 100 1100 700]);
ax1 = axes('Color', [0.1 0.1 0.1], 'XColor', 'w', 'YColor', 'w');
hold on; grid on;
set(ax1, 'GridColor', [0.4 0.4 0.4], 'GridAlpha', 0.5);

% --- Preparación de Datos y Colores ---
n_steer = length(steer_int);
n_slip = length(yaw_slip_int);
cmap_steer = jet(n_steer);  % Gradiente para Steer
cmap_slip = parula(n_slip); % Gradiente para Slip

h_steer = zeros(1, n_steer);
labels_steer = cell(1, n_steer);
h_slip = zeros(1, n_slip);
labels_slip = cell(1, n_slip);

% --- Plot Isolíneas de Steer (SI) ---
for i = 1:n_steer
    h_steer(i) = plot(ax1, ay_matrix(i, :), yaw_moment_matrix(i, :), ...
        'Color', cmap_steer(i,:), 'LineWidth', 1.2);
    labels_steer{i} = sprintf('SI = %.1f°', steer_int(i));
end

% --- Plot Isolíneas de Slip (VS) ---
for j = 1:n_slip
    h_slip(j) = plot(ax1, ay_matrix(:, j), yaw_moment_matrix(:, j), ...
        '--', 'Color', cmap_slip(j,:), 'LineWidth', 1);
    labels_slip{j} = sprintf('VS = %.1f°', rad2deg(yaw_slip_int(j)));
end

xlabel('Lateral accel [gs]');
ylabel('Yaw Moment [N·m]');
title('Yaw Moment Diagram (YMD)', 'Color', 'w');

% --- Creación de las dos Leyendas ---

% Leyenda 1: Steer Input (SI) - Esquina inferior derecha
lgd1 = legend(ax1, h_steer, labels_steer, 'Location', 'southeast', ...
    'TextColor', 'w', 'Color', [0.2 0.2 0.2], 'EdgeColor', [0.5 0.5 0.5], 'FontSize', 7);
lgd1.NumColumns = 1;

% Leyenda 2: Vehicle Slip (VS) - Esquina superior izquierda
% Se crea un eje invisible para soportar la segunda leyenda
ax2 = axes('Position', ax1.Position, 'Visible', 'off');
hold on;
lgd2 = legend(ax2, h_slip, labels_slip, 'Location', 'northwest', ...
    'TextColor', 'w', 'Color', [0.2 0.2 0.2], 'EdgeColor', [0.5 0.5 0.5], 'FontSize', 7);
lgd2.NumColumns = 1;

% Ajuste de límites para centrar el diagrama
axis(ax1, 'tight');
margins = 0.1;
xlim(ax1, [min(ay_matrix(:))-margins, max(ay_matrix(:))+margins]);
ylim(ax1, [min(yaw_moment_matrix(:))-100, max(yaw_moment_matrix(:))+100]);