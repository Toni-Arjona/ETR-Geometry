function rolling_resistance_coeff(car_mass, camber_deg, tire_pressure, car_velocity, r_eff, slip_ratio)
%Longitudinal Coefficients
PCX1 = 1.56182385630461; %Shape factor Cfx for longitudinal force
PDX1 = 2.85110165444411; %Longitudinal friction Mux at Fznom
PDX2 = - 0.407371062621199; %Variation of friction Mux with load
PPX1=- 0.705319191164713;
PPX2=- 0.589490385312056;
PPX3=- 0.242820291164767;
PPX4=0.205179565555030;
PDX3= 19.2614164371048;
PEX1=0.422733521935518;
PEX2=0.0201014651759272;
PEX3=0.00229620366835657;
PEX4=0.00999560321822648;
PKX1=52.2555801076937;
PKX2=- 0.00614387636030559;
PKX3=- 0.155693449933703;
PHX1=0.000340072159079639;
PHX2=- 0.00161506337261505;
%PDXP1=
%PDXP2=
%PDXP3=
%RHX1=
%REX1=
%REX2=
%RCX1=
%RBX1=
%RBX2=
%RBX3=
SVX=1;

%Overturning coeficients
QSX1= 0;
QSX2= 0;
QSX3= 0;
QSX4= 5;
QSX5= 1;
QSX6= 10;
QSX7= 0;
QSX8= 0;
QSX9= 0.4;
QSX10= 0;
QSX11= 5;
QSX12= 0;
QSX13= 0;
QSX14= 0;
PPMX1= 0;

%Rolling coefficients
QSY1 = 0.01; %Rolling resistance torque coefficient
QSY2 = 0.0; %Rolling resistance torque depending on Fx
QSY3 = 0.0004; %Rolling resistance torque depending on speed
QSY4 = 4e-05; %Rolling resistance torque depending on speed ^4               
QSY5= 0;                 
QSY6= 0;                
QSY7= 0;                
QSY8= 0; 

%Scaling coefficients
LCX=0.995; %Scale factor of Fx shape factor; valor inventat
LMUX=0.78; %Scale factor of Fx peak friction coefficient; valor inventat
LEX=1; %Scale factor of Fx curvature factor; valor inventat
LKXk=1; %Scale factor of slip stiffness; valor inventat 
LHX=0.95; %Scale factor of Fx horizontal shift; valor inventat
LUX=1; %valor inventat
LMY=1;

%% Car data
g=9.81; % m/s^2
m= car_mass; % vechicle mass in kg
W = m*g; % vehicle weight in N
h = 0.3; % cog height m
l = 1.6; % wheel base m
cogx= 0.8; % Front axle -> Mass center distance in m
%R = 0.223969; %efective rolling radius in m
R= (16*0.0245)/2; %unloaded radius in m
CAM = camber_deg*pi/180; %Camber in radians
VREF= 11.176; %velocidad de referncia (nominal) en m/s

%Data for Fx
slip = 1:0.02:1.3;
VV = car_velocity;
FZ = m*g/4; % single wheel load 
DFZ = (FZ-1080)/1080; %diferencial de carrega
P0 = 0.82737; %pressio en bar
DPI = (tire_pressure-P0)/P0;

%Fx MF-Tyre 5.2, 6.0, 6.1
s1=1;
SHX= (PHX1+PHX2*DFZ)*LHX*LUX*s1;

for i = 1:length(slip)
        
    V(i)= VV*slip(i); % Wheel velocity m/s
    Omega(i) = V(i)/R; %wheel rotational speed %valor inventat
    k(i) = V(i)-VV/VV; %longitudinal slip

    %Pure Slip
    kx(i) = k(i)+SHX;
    CX(i) = PCX1*LCX;
    U(i) = (PDX1+PDX2*DFZ)*(1+PPX3*DPI+PPX4*DPI^2)*(1-PDX3*CAM^2)*LUX;
    DX(i) = U(i)*FZ*s1;
    Ex(i) = (PEX1+PEX2*DFZ+PEX3*DFZ^2)*(1-PEX4*sign(kx(i)))*LEX;
    KXk(i) = FZ*(PKX1+PKX2*DFZ)*exp(PKX3*DFZ)*(1+PPX1*DPI+PPX2*DPI^2)*LKXk;
    BX(i) = KXk(i)/(CX(i)*DX(i));
        
    Gxalfa=1;
        
    %Turn slip
    s1=1;
    Fx(i)=(DX(i)*sin(CX(i)*atan(BX(i)*kx(i)-Ex(i)*(BX(i)*kx(i)-atan(BX(i)*kx(i)))))+SVX)*Gxalfa;
        

    %Rolling Resistance Moment MF-Tyre 5.2, 6.0
    My(i)=-R.*FZ.*LMY.*(QSY1+QSY2.*(Fx(i)/FZ)+QSY3.*abs(V(i)/VREF)+QSY4.*(V(i)/VREF).^4);
    RR_coeff(i)= My(i)/(FZ*r_eff);
end

%plot(slip, RR_coeff)
rolling_resistance_coeff(275, 1.5, 0.9, 50/3.6, 0.2015)
